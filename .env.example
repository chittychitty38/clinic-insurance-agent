# Stedi sandbox: portal.stedi.com -> account menu -> API Keys -> Generate -> Mode: Test
STEDI_API_KEY=

# Vapi: dashboard.vapi.ai -> API Keys -> Private Key
VAPI_API_KEY=

# Random string Vapi sends on every webhook (generate: openssl rand -hex 24)
VAPI_WEBHOOK_SECRET=

# Public URL of this server (ngrok/cloudflared locally; Render sets RENDER_EXTERNAL_URL itself)
PUBLIC_BASE_URL=

# Optional
# FRONT_DESK_NUMBER=+15551234567   # enables live transfer to a human
# DASHBOARD_TOKEN=                 # protects the dashboard (?token=...)
# VAPI_MODEL=claude-haiku-5-5
# VAPI_VOICE_ID=Savannah
